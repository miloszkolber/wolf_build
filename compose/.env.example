# Select immutable accepted digests before a real rollout.
GATE_IMAGE=ghcr.io/miloszkolber/gate:816b5f152e99@sha256:791ef11cb13be5fbcc59ae5cdb77512c57a30bcb2ab5d729294cd09976e28b40
WOLF_IMAGE=ghcr.io/miloszkolber/wolf_runtime:latest
GATE_PROFILE=port-handoff
GATE_HOST=0.0.0.0
GATE_CONTAINER_NAME=wolf
GATE_RUNTIME=wolf-runtime
GATE_TCP_PORTS=47984,47989,48010
GATE_UDP_PORTS=47999,48100,48200
GATE_ACTIVITY_PREFIXES=wolf-,wolf_,wolf
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Replace group IDs and hidraw major for the target host.
DOCKER_GID=1000
RENDER_GID=1000
HIDRAW_MAJOR=240
DRI_CARD=/dev/dri/card0
WOLF_RENDER_NODE=/dev/dri/renderD128
STATE_DIR=./state
SOCKET_DIR=./state/sockets
IDLE_TIMEOUT=300
STARTUP_TIMEOUT=90
CONNECTION_IDLE_TIMEOUT=600
WOLF_LOG_LEVEL=INFO
WOLF_STOP_CONTAINER_ON_EXIT=TRUE
LIBVA_DRIVER_NAME=iHD
TZ=UTC
