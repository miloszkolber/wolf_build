# Set an exact tested candidate digest. No accepted latest exists yet.
WOLF_IMAGE=ghcr.io/miloszkolber/wolf_runtime@sha256:REPLACE_WITH_TESTED_DIGEST
# Replace group IDs and hidraw major for the target host.
DOCKER_GID=1000
RENDER_GID=1000
HIDRAW_MAJOR=240
# Prefer the actual discrete GPU's /dev/dri/by-path/<PCI identity>-render link.
# Replace this numeric example if the host provides a stable by-path identity.
WOLF_RENDER_NODE=/dev/dri/renderD128
